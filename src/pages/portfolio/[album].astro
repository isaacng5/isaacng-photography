---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import Lightbox from '../../components/Lightbox.astro';
import { albums } from '../../data/albums';
import { photosIn } from '../../data/photos';

export const getStaticPaths = (() =>
  albums.map((album) => ({
    params: { album: album.slug },
    props: { album },
  }))) satisfies GetStaticPaths;

const { album } = Astro.props;
const items = photosIn(album.slug);
const index = albums.findIndex((a) => a.slug === album.slug);
const next = albums[(index + 1) % albums.length];
---

<Base
  title={album.title}
  description={`${album.note} ${items.length} photographs by Isaac Ng.`}
  ground={album.ground}
>
  <header class="head page">
    <a class="label head__back" href="/portfolio">
      <svg width="22" height="8" viewBox="0 0 22 8" aria-hidden="true">
        <path d="M22 4H2M5 1L2 4l3 3" fill="none" stroke="currentColor" stroke-width="1.2"></path>
      </svg>
      Portfolio
    </a>
    <h1 class="title head__title" style={`view-transition-name: album-${album.slug}`}>
      {album.title}
    </h1>
    <p class="label head__count">{items.length} photographs</p>
  </header>

  <div class="page">
    <PhotoGrid photos={items} />
  </div>

  <nav class="next page" aria-label="Next set">
    <a class="next__link" href={`/portfolio/${next.slug}`}>
      <span class="label">Next set</span>
      <span class="title next__title">{next.title}</span>
    </a>
  </nav>

  <Lightbox photos={items} albumTitle={album.title} />
</Base>

<style>
  @layer components {
    .head {
      padding-block: clamp(var(--space-8), 6vh, var(--space-16)) var(--space-12);
    }

    .head__back {
      display: inline-flex;
      align-items: center;
      gap: var(--space-3);
      transition: color var(--duration-ui) var(--ease);
    }

    .head__back:hover {
      color: var(--ink);
    }

    .head__title {
      margin-top: var(--space-6);
      color: var(--ink);
    }

    .head__count {
      margin-top: var(--space-4);
      padding-top: var(--space-4);
      border-top: 1px solid var(--edge);
    }

    .next {
      margin-top: var(--space-24);
    }

    .next__link {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      padding-top: var(--space-8);
      border-top: 1px solid var(--edge);
      color: var(--muted);
      transition: color var(--duration-ui) var(--ease);
    }

    .next__link:hover {
      color: var(--ink);
    }

    .next__title {
      color: var(--ink);
    }
  }
</style>
