---
import { Image } from 'astro:assets';
import type { Photo } from '../data/photos';

interface Props {
  photos: Photo[];
  albumTitle: string;
}
const { photos, albumTitle } = Astro.props;
---

<dialog class="lb" data-lightbox aria-label={`${albumTitle}, full size`}>
  <div class="lb__ambient" aria-hidden="true"></div>

  <button type="button" class="lb__close" data-close aria-label="Close">
    <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
      <path d="M1 1l16 16M17 1L1 17" fill="none" stroke="currentColor" stroke-width="1.3"></path>
    </svg>
  </button>

  <button type="button" class="lb__nav lb__nav--prev" data-prev aria-label="Previous photograph">
    <svg width="26" height="10" viewBox="0 0 26 10" aria-hidden="true">
      <path d="M26 5H2M6 1L2 5l4 4" fill="none" stroke="currentColor" stroke-width="1.3"></path>
    </svg>
  </button>

  <button type="button" class="lb__nav lb__nav--next" data-next aria-label="Next photograph">
    <svg width="26" height="10" viewBox="0 0 26 10" aria-hidden="true">
      <path d="M0 5h24M20 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3"></path>
    </svg>
  </button>

  <div class="lb__stage">
    {
      photos.map((p, i) => (
        <figure class="lb__figure" data-slide={i} hidden>
          {/*
            Widths deliberately overlap the grid's 640 and 1280 at the same
            quality, so those derivatives are generated once and shared rather
            than duplicated. Dropping quality here instead cost 36MB.
          */}
          <Image
            src={p.src}
            alt={p.alt}
            widths={[640, 1280, 1920, 2560]}
            sizes="94vw"
            loading="lazy"
            decoding="async"
            class="lb__img"
          />
          {/*
            No descriptive caption. The alt text already carries the description
            for anyone who needs it, and restating it under the photograph tells
            a sighted viewer what they can plainly see. Only the position, which
            the frame genuinely cannot convey, is worth showing.
          */}
          <figcaption class="label lb__cap">
            {i + 1} / {photos.length}
          </figcaption>
        </figure>
      ))
    }
  </div>

  <p class="visually-hidden" aria-live="polite" data-announce></p>
</dialog>

<style>
  @layer components {
    .lb {
      width: 100vw;
      max-width: 100vw;
      height: 100svh;
      max-height: 100svh;
      padding: 0;
      border: 0;
      background: var(--album-ground);
      color: var(--ink);
      overflow: hidden;
    }

    .lb::backdrop {
      background: #000;
      opacity: 0.92;
    }

    /* The surround takes the colour of whichever photograph is open. Kept low
       enough that it reads as warmth in the room rather than a colour wash. */
    .lb__ambient {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: radial-gradient(
        60% 50% at 50% 45%,
        color-mix(in srgb, var(--light) 16%, transparent),
        transparent 70%
      );
      transition: background var(--duration-ambient) var(--ease);
    }

    .lb__stage {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      padding: clamp(var(--space-12), 5vh, var(--space-16)) clamp(var(--space-8), 6vw, var(--space-16));
    }

    .lb__figure {
      grid-area: 1 / 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-4);
      margin: 0;
      max-width: 100%;
      max-height: 100%;
      animation: lb-in var(--duration-ui) var(--ease);
    }

    .lb__figure[hidden] {
      display: none;
    }

    @keyframes lb-in {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }

    .lb__img {
      width: auto;
      height: auto;
      max-width: 100%;
      /* Leave room for the stage padding and the counter beneath the frame. */
      max-height: calc(100svh - 13rem);
      object-fit: contain;
    }

    .lb__cap {
      text-align: center;
    }

    .lb__close,
    .lb__nav {
      position: absolute;
      z-index: 2;
      display: grid;
      place-items: center;
      width: 3rem;
      height: 3rem;
      color: var(--muted);
      transition: color var(--duration-ui) var(--ease);
    }

    .lb__close:hover,
    .lb__nav:hover {
      color: var(--ink);
    }

    .lb__close {
      top: var(--space-4);
      right: var(--space-4);
    }

    .lb__nav--prev {
      left: var(--space-2);
      top: 50%;
      transform: translateY(-50%);
    }

    .lb__nav--next {
      right: var(--space-2);
      top: 50%;
      transform: translateY(-50%);
    }

    @media (prefers-reduced-motion: reduce) {
      .lb__figure {
        animation: none;
      }
      .lb__ambient {
        transition: none;
      }
    }

    @media (max-width: 40rem) {
      .lb__nav {
        bottom: var(--space-4);
        top: auto;
        transform: none;
      }
      .lb__nav--prev {
        left: var(--space-6);
      }
      .lb__nav--next {
        right: var(--space-6);
      }
      .lb__img {
        max-height: calc(100svh - 14rem);
      }
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (dialog) {
    const slides = [...dialog.querySelectorAll<HTMLElement>('[data-slide]')];
    const triggers = [...document.querySelectorAll<HTMLButtonElement>('[data-photo]')];
    const announce = dialog.querySelector<HTMLElement>('[data-announce]');
    const ambient = dialog.querySelector<HTMLElement>('.lb__ambient');
    let current = 0;
    let opener: HTMLElement | null = null;

    const show = (next: number) => {
      current = (next + slides.length) % slides.length;
      slides.forEach((s, i) => s.toggleAttribute('hidden', i !== current));
      const light = triggers[current]?.dataset.light;
      if (light && ambient) ambient.style.setProperty('--light', light);
      if (announce) announce.textContent = `Photograph ${current + 1} of ${slides.length}`;
    };

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    /**
     * Grow the full size frame out of the thumbnail that was clicked, so the
     * photograph you picked is visibly the one that opens. Measure both boxes,
     * start the big one transformed onto the small one, then release it.
     */
    const growFrom = (thumb: HTMLElement) => {
      if (reduced.matches) return;
      const target = slides[current]?.querySelector<HTMLElement>('.lb__img');
      if (!target) return;

      const from = thumb.getBoundingClientRect();
      const to = target.getBoundingClientRect();
      if (!to.width || !to.height) return;

      const dx = from.left + from.width / 2 - (to.left + to.width / 2);
      const dy = from.top + from.height / 2 - (to.top + to.height / 2);
      const scale = from.width / to.width;

      target.animate(
        [
          { transform: `translate(${dx}px, ${dy}px) scale(${scale})`, opacity: 0.4 },
          { transform: 'none', opacity: 1 },
        ],
        { duration: 420, easing: 'cubic-bezier(0.22, 0.61, 0.36, 1)' }
      );
    };

    const open = (index: number, from: HTMLElement) => {
      opener = from;
      show(index);
      dialog.showModal();
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => growFrom(from));
    };

    const close = () => {
      dialog.close();
    };

    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
      opener?.focus();
      opener = null;
    });

    triggers.forEach((btn, i) => btn.addEventListener('click', () => open(i, btn)));
    dialog.querySelector('[data-close]')?.addEventListener('click', close);
    dialog.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));

    // <dialog> already traps focus and handles Escape. Only the arrows are ours.
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        show(current - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        show(current + 1);
      }
    });

    // Click the surround to dismiss, but never a click on the photograph itself.
    dialog.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target === dialog || target.classList.contains('lb__stage')) close();
    });

    let startX = 0;
    dialog.addEventListener(
      'touchstart',
      (e) => {
        startX = e.changedTouches[0].screenX;
      },
      { passive: true }
    );
    dialog.addEventListener(
      'touchend',
      (e) => {
        const dx = e.changedTouches[0].screenX - startX;
        if (Math.abs(dx) > 48) show(current + (dx < 0 ? 1 : -1));
      },
      { passive: true }
    );
  }
</script>
