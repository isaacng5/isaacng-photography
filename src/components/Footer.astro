---
import { SITE } from '../data/albums';

interface Props {
  flush?: boolean;
}
const { flush = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class:list={['foot', flush && 'foot--flush']}>
  <div class="foot__inner page">
    <p class="label">© {year} Isaac Ng</p>
    <a class="foot__ig label" href={SITE.instagramUrl} rel="me noopener" target="_blank">
      Instagram @{SITE.instagram}
    </a>
  </div>
</footer>

<style>
  @layer components {
    .foot {
      margin-top: var(--space-32);
      border-top: 1px solid var(--edge);
    }

    .foot--flush {
      margin-top: 0;
      border-top: 0;
    }

    .foot__inner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      padding-block: var(--space-8);
    }

    .foot__ig {
      color: var(--muted);
      transition: color var(--duration-ui) var(--ease);
    }

    .foot__ig:hover {
      color: var(--ink);
    }
  }
</style>
